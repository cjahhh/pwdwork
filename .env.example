# Copy to .env if needed. Vite embeds this public setting at build time.
# /api needs production routing to Laravel; the Vite proxy is development-only.
# For sibling subdomains: https://api.example.com/api (configure Sanctum/CORS/cookie domain too).
VITE_API_URL=/api
# Public, owner-approved support mailbox only. Blank shows an unavailable notice.
# VITE_* values are public browser-build settings; never put secrets here.
VITE_SUPPORT_EMAIL=
