# TEMPLATE: replace every ${PWDWORK_...} token before nginx -t. Do not run envsubst
# over all variables: $uri, $host, $request_uri and Nginx variables must remain literal.
server {
    listen 80;
    server_name ${PWDWORK_DOMAIN};
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name ${PWDWORK_DOMAIN};
    ssl_certificate ${PWDWORK_TLS_CERTIFICATE};
    ssl_certificate_key ${PWDWORK_TLS_KEY};
    root ${PWDWORK_RELEASE}/frontend;
    index index.html;
    server_tokens off;
    client_max_body_size 1m;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # Inline styles are used by React components and the escaped resume preview.
    # Validate this policy against the built assets in staging; Vite dev/HMR needs a different policy.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-src 'self' about:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;

    # Disable access logs to avoid collecting reset-token query strings. Error logs
    # can still contain request URLs: keep them private with short retention.
    # Add a reviewed status/latency log format if required; never log request bodies.
    access_log off;
    error_log ${PWDWORK_PRIVATE_LOG_DIRECTORY}/nginx-error.log warn;

    location ~ (^|/)\. { deny all; }
    location ~ ^/(api|sanctum)(/|$) {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME ${PWDWORK_RELEASE}/backend/public/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param DOCUMENT_ROOT ${PWDWORK_RELEASE}/backend/public;
        fastcgi_pass unix:${PWDWORK_PHP_FPM_SOCKET};
        fastcgi_read_timeout 60s;
        fastcgi_hide_header X-Powered-By;
    }
    location ~ \.php$ { return 404; }
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        # Keep previous hashed assets available across deployments and rollbacks.
    }
    location / {
        try_files $uri $uri/ /index.html;
        expires -1;
    }
}
