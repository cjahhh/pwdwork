# Allow only the inputs used by Dockerfile. Local data never enters the context.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!index.html
!vite.config.js
!src/
!src/**
!public/
!public/**
!backend/
!backend/composer.json
!backend/composer.lock
!backend/artisan
!backend/app/
!backend/app/**
!backend/bootstrap/
!backend/bootstrap/**
!backend/config/
!backend/config/**
!backend/database/
!backend/database/migrations/
!backend/database/migrations/**
!backend/resources/
!backend/resources/**
!backend/routes/
!backend/routes/**
!backend/public/
!backend/public/index.php
!deploy/
!deploy/docker/
!deploy/docker/php.ini
!deploy/docker/php-fpm.conf
!deploy/docker/nginx.conf.template
!deploy/docker/fastcgi-app.conf
!deploy/docker/entrypoint.sh
!deploy/docker/run-services.sh
!deploy/docker/check-environment.php
!deploy/docker/storage-connectivity-test.php
# These final exclusions also apply inside otherwise allowed directories.
**/.env
**/.env.*
**/*.env
**/*.env.*
**/.git
**/node_modules
**/vendor
**/storage
backend/bootstrap/cache/**
**/secrets/**
**/*secret*
**/*credentials*
**/auth.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.crt
**/*.cer
**/*.sql
**/*.sql.*
**/*.sqlite*
**/*.db
**/*.log
**/*.bak
**/*.backup
**/*.zip
**/*.tar*
**/*.gz
**/*.pdf
**/*.doc
**/*.docx
**/*.map
