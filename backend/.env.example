APP_NAME=PWDWork
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# Exact browser origins, comma separated. FRONTEND_URL stays one trusted reset-email URL.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Comma-separated provider-controlled proxy IPs/CIDRs; empty trusts none.
# Do not trust arbitrary forwarded headers from the public internet.
TRUSTED_PROXIES=
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Create an empty database and use an account authorized for that database.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pwdwork
DB_USERNAME=root
DB_PASSWORD=
# For a managed MySQL server requiring TLS, set its CA certificate path.
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Keep resume storage private; cloud storage needs its adapter and credentials.
RESUME_DISK=local
QUEUE_CONNECTION=database
# Password recovery always uses this asynchronous connection, independently of QUEUE_CONNECTION.
PASSWORD_RESET_QUEUE_CONNECTION=database
PASSWORD_RESET_QUEUE=password-resets
# In-app decisions are always saved. Optional email is queued after commit.
ADMIN_NOTIFICATION_MAIL=false
ADMIN_NOTIFICATION_QUEUE_CONNECTION=database
ADMIN_NOTIFICATION_QUEUE=notifications

# Shared across instances, including public endpoint rate limits.
CACHE_STORE=database

# Use smtp with provider credentials for real delivery. log is development only.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
