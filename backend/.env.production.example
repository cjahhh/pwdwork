# TEMPLATE ONLY: fill in a separate staging/production secret store; never replace the local .env.
# No real domains, credentials or application key are supplied here.
APP_NAME=PWDWork
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=
FRONTEND_URL=
# Keep off for the schema/compatibility rollout; enable only after separate approval.
EMAIL_VERIFICATION_ENABLED=false
# Optional: inherits the existing password-recovery connection; never use sync.
# EMAIL_VERIFICATION_QUEUE_CONNECTION=deferred
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Same-origin routing is recommended. Fill each with the actual HTTPS browser origin/host.
CORS_ALLOWED_ORIGINS=
SANCTUM_STATEFUL_DOMAINS=
# Empty when directly serving HTTPS. Otherwise pin the reverse proxy IP/CIDR supplied by your provider.
TRUSTED_PROXIES=
SESSION_DRIVER=database
SESSION_CONNECTION=mysql
SESSION_COOKIE=pwdwork-session
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true

DB_CONNECTION=mysql
DB_URL=
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Required when connecting to a remote managed MySQL service; use the provider CA file.
MYSQL_ATTR_SSL_CA=
CACHE_STORE=database
DB_CACHE_CONNECTION=mysql
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=mysql
DB_QUEUE_RETRY_AFTER=90
PASSWORD_RESET_QUEUE_CONNECTION=database
PASSWORD_RESET_QUEUE=password-resets
ADMIN_NOTIFICATION_MAIL=false
ADMIN_NOTIFICATION_QUEUE_CONNECTION=database
ADMIN_NOTIFICATION_QUEUE=notifications

FILESYSTEM_DISK=local
RESUME_DISK=local
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
BROADCAST_CONNECTION=log

# Supply an authorized sender and tested delivery credentials; log/array must not be used publicly.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=PWDWork
